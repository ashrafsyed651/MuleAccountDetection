name: "gnn_embedder"
platform: "pytorch_libtorch"
max_batch_size: 128

input [
  {
    name: "x"
    data_type: TYPE_FP32
    dims: [ -1, 10 ]
  },
  {
    name: "edge_index"
    data_type: TYPE_INT64
    dims: [ 2, -1 ]
  }
]

output [
  {
    name: "embedding"
    data_type: TYPE_FP32
    dims: [ -1, 64 ]
  }
]
