name: "ensemble_pipeline"
platform: "ensemble"
max_batch_size: 128

input [
  {
    name: "ACCOUNT_ID"
    data_type: TYPE_STRING
    dims: [ 1 ]
  },
  {
    name: "GNN_X"
    data_type: TYPE_FP32
    dims: [ -1, 10 ]
  },
  {
    name: "GNN_EDGE_INDEX"
    data_type: TYPE_INT64
    dims: [ 2, -1 ]
  }
]

output [
  {
    name: "IS_MULE_PROBABILITY"
    data_type: TYPE_FP32
    dims: [ 1 ]
  }
]

ensemble_scheduling {
  step [
    {
      model_name: "feature_fetcher"
      model_version: -1
      input_map {
        key: "ACCOUNT_ID"
        value: "ACCOUNT_ID"
      }
      output_map {
        key: "FEAST_FEATURES"
        value: "feast_features_out"
      }
    },
    {
      model_name: "gnn_embedder"
      model_version: -1
      input_map {
        key: "x"
        value: "GNN_X"
      }
      input_map {
        key: "edge_index"
        value: "GNN_EDGE_INDEX"
      }
      output_map {
        key: "embedding"
        value: "gnn_embedding_out"
      }
    },
    {
      model_name: "feature_combiner"
      model_version: -1
      input_map {
        key: "FEAST_FEATURES"
        value: "feast_features_out"
      }
      input_map {
        key: "GNN_EMBEDDING"
        value: "gnn_embedding_out"
      }
      output_map {
        key: "COMBINED_FEATURES"
        value: "combined_features_out"
      }
    },
    {
      model_name: "xgb_classifier"
      model_version: -1
      input_map {
        key: "input__0"
        value: "combined_features_out"
      }
      output_map {
        key: "output__0"
        value: "IS_MULE_PROBABILITY"
      }
    }
  ]
}
